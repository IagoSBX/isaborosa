SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3309/biblioteca?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=biblioteca
DB_PASSWORD=biblioteca

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,https://isaborosa.vercel.app

OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_BASE_URL=https://covers.openlibrary.org
OPENLIBRARY_TIMEOUT_MS=8000

# Segunda fonte de busca (mais livros, resultados combinados com a Open
# Library). Sem uma API key, essa fonte fica desativada e a busca continua
# funcionando so com a Open Library. Gratis e instantaneo: crie um projeto em
# https://console.cloud.google.com/, ative a "Books API" e gere uma chave em
# "Credenciais" (nao precisa de conta de desenvolvedor aprovada, ao contrario
# de Amazon/Mercado Livre).
GOOGLEBOOKS_BASE_URL=https://www.googleapis.com
GOOGLEBOOKS_TIMEOUT_MS=5000
GOOGLEBOOKS_API_KEY=

MERCADOLIVRE_BASE_URL=https://api.mercadolibre.com
MERCADOLIVRE_TIMEOUT_MS=5000
# Autenticacao para a API do Mercado Livre (sem ela, a busca de precos
# retorna 403 e essa fonte fica omitida da lista, sem inventar preco).
# Opcao A - mais simples de manter funcionando sozinho: crie um app "sem
# necessidade de autorizacao do usuario" em
# https://developers.mercadolivre.com.br/ (gratis, ~2 min) e preencha:
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Opcao B - um access token ja pronto (expira, precisa renovar manualmente):
MERCADOLIVRE_ACCESS_TOKEN=

PRICE_CACHE_MINUTES=20

# Amazon Product Advertising API (SearchItems). Exige uma conta de Associados
# JA APROVADA (a Amazon so aprova depois de 3 vendas qualificadas em ate 180
# dias - bem mais restrito que o Mercado Livre). Sem essas 3 variaveis
# preenchidas, a fonte Amazon fica desativada (sem inventar preco).
# Credenciais em https://affiliate-program.amazon.com.br/assoc_credentials/home
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# "Tracking ID" da sua conta de Associados, ex.: seunome-20
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.com.br
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_TIMEOUT_MS=5000
